# Copy to engine/.env (gitignored) for `python -m wismo serve`; in containers set these as env vars / secrets.
# Every value below is the default unless noted. Never commit real keys.

# ---- model (optional: without a key, answers and resolutions use the deterministic templates) ----
GEMINI_API_KEY=
# comma-separated fallback list: free-tier quotas are per model (gemini-3.8-flash allows 20 requests a day)
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# ANTHROPIC_API_KEY=                    # alternative provider (pip install "wismo[llm]")
# LLM_DAILY_BUDGET=1500                 # model calls per UTC day across all instances; then templates, never an error
# LLM_IP_DAILY=100                      # model calls per client IP per UTC day

# ---- serving ----
# PORT=8787                             # Cloud Run sets 8080; --port wins over it
# SITE_URL=https://cierto.example       # replaces __SITE_URL__ in the site's text files; unset = the request's origin
# WEB_DIST=../apps/web/dist             # where the built site is (WISMO_WEB_DIST still works)
# CIERTO_SDK_DIST=../packages/cierto-js/dist
# LOG_FORMAT=                           # json (production, one JSON line per request) | text | unset (dev: quiet)
# GRACEFUL_SHUTDOWN_SECONDS=8           # drain time after SIGTERM (Cloud Run allows 10)
# KEEP_ALIVE_SECONDS=75                 # longer than the load balancer's upstream idle timeout
# SERVED_BY=                            # X-Served-By value; default: the hostname

# ---- behind a load balancer ----
# REDIS_URL=                            # redis:// or rediss:// (Upstash): shared sessions, limits, LLM budget.
#                                       # Unset = in-memory, correct for ONE instance only.
# REDIS_PREFIX=cierto:
# TRUSTED_PROXY_HOPS=1                  # X-Forwarded-For entries appended by proxies you run (Cloud Run/Caddy: 1;
#                                       # Google external ALB in front of Cloud Run: 2; nothing in front: 0)
# FORWARDED_ALLOW_IPS=127.0.0.1         # whose X-Forwarded-Proto uvicorn believes (the container sets *)

# ---- sessions ----
# SESSION_TTL_SECONDS=7200              # a demo session expires after this long idle
# SESSION_MAX_LIVE=5000                 # live demo sessions kept; the least recently used go first
# SESSION_CACHE_SIZE=128                # materialized sessions cached per instance (~0.4 MB each)
# SDK_TTL_SECONDS=86400                 # an idle SDK test tenant starts over after this long
# SDK_LOG_MAX_OPS=2000                  # writes before a shared SDK sandbox starts a fresh log (config kept)

# ---- WAF ----
# WAF_RATE_LIMITS=on                    # off disables every rate limit (the test suite does)
# RATE_LIMIT_GENERAL=300/m              # per client IP, every request
# RATE_LIMIT_ASK=20/m,200/d             # per IP, the LLM-backed ask endpoints
# RATE_LIMIT_DEMO_CREATE=20/10m         # per IP, POST /v1/demo/sessions
# RATE_LIMIT_SDK_WRITE=60/m             # per IP, SDK POST/PUT
# RATE_LIMIT_SDK_KEY=600/m              # per API key, SDK POST/PUT
# MAX_BODY_BYTES=65536                  # 413 above this
# MAX_EVENTS_BODY_BYTES=1048576         # POST /v1/events (batches of up to 100 events)

# ---- SDK test mode ----
# CIERTO_ENV=dev                        # live|prod|production turns off /v1/dev/*
# CIERTO_DEV_SEED=cierto-dev-2026       # derives the test keys
