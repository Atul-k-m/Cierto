{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [],
    "paths": { "lucide": ["./node_modules/lucide"] }
  },
  "include": ["src", "../../apps/web/src/widget"]
}
